{
  "name": "@ama-work/mcp-atlassian",
  "version": "1.2.0",
  "description": "Standalone TypeScript MCP server wrapping the Atlassian REST API (Jira + Confluence)",
  "main": "dist/index.js",
  "bin": {
    "mcp-atlassian": "dist/index.js"
  },
  "type": "module",
  "scripts": {
    "start": "bun src/index.ts",
    "build": "tsc --project tsconfig.build.json",
    "lint": "tsc --noEmit && knip && eslint .",
    "test": "vitest run",
    "release": "semantic-release",
    "prepublishOnly": "bun run build",
    "prepare": "husky"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "confluence.js": "^3.2.0",
    "jira.js": "^6.2.0",
    "zod": "^4.3.6"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@commitlint/cli": "^21.2.0",
    "@commitlint/config-conventional": "^21.2.0",
    "@commitlint/types": "^21.2.0",
    "@semantic-release/commit-analyzer": "12",
    "conventional-changelog-conventionalcommits": "^9.0.0",
    "@semantic-release/git": "10",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "12",
    "@semantic-release/release-notes-generator": "12",
    "@types/bun": "^1.3.13",
    "eslint": "^9.0.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "husky": "^9.1.7",
    "knip": "^6.6.2",
    "semantic-release": "24",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.59.3",
    "vitest": "^2.0.5"
  }
}
